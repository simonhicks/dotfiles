###############################################################################
# Window Navigation
###############################################################################

## Relative Parent
bindsym $alt+a focus parent

## Relative Child
bindsym $alt+z focus child

## Relative Window
bindsym $alt+h focus left
bindsym $alt+j focus down
bindsym $alt+k focus up
bindsym $alt+l focus right

## Last Focused Window
bindsym $alt+semicolon exec --no-startup-id pkill -USR1 -F "${XDG_RUNTIME_DIR}/swap_focus.pid"
exec --no-startup-id i3-swap-focus

## Move Window
bindsym $alt+Shift+h move left
bindsym $alt+Shift+j move down
bindsym $alt+Shift+k move up
bindsym $alt+Shift+l move right

## Vertical/Horizontal/Tab Window splits
bindsym $alt+Shift+minus split vertical
bindsym $alt+Shift+backslash split horizontal
bindsym $alt+t split vertical; layout tabbed


## Toggle container layout
bindsym $alt+Shift+t layout toggle tabbed splith splitv

## Window Fullscreen Toggle
bindsym $alt+f fullscreen toggle
