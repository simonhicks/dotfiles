###############################################################################
# Closing Windows
###############################################################################

## Exit App
bindsym $alt+w [con_id="__focused__"] kill
bindsym $alt+q [con_id="__focused__"] kill

## Terminate App
bindsym $alt+Shift+q [con_id="__focused__"] exec --no-startup-id kill -9 $(xdotool getwindowfocus getwindowpid)
